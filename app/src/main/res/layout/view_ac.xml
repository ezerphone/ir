<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dial">
            <TextView
                android:id="@+id/tempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="24°"
                android:textSize="46sp"
                android:textColor="@color/textPrimary"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">
            <TextView
                android:id="@+id/tempMinus"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_circle"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/textPrimary"
                android:text="–"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/powerBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="26dp"
                android:background="@drawable/btn_circle_power"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/power"
                android:text="⏻"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tempPlus"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_circle"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/textPrimary"
                android:text="+"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView style="@style/AcLabel" android:text="@string/mode" />
        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/AcLabel" android:text="@string/fan" />
        <Spinner
            android:id="@+id/fanSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="שלח מצב" />
    </LinearLayout>
</ScrollView>
